<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                x:Class="PS5Kitsune.App.Views.ToolsView"
                x:DataType="vm:ToolsViewModel">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="Build tools" Classes="h1" />
      <TextBlock Text="Build mode compiles AnyPS5 with portable tools kept in the data folder. Nothing is installed system-wide." TextWrapping="Wrap" />
      <Border Classes="card">
        <ItemsControl ItemsSource="{Binding Tools}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolRowViewModel">
              <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                <c:StatusChip Kind="{Binding Kind}" Text="{Binding StatusText}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Version}" Classes="caption" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DownloadText}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding DiskText}" Classes="caption" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Back" Command="{Binding BackCommand}" IsCancel="True" />
        <Button Content="{Binding ContinueText}" Classes="accent" Command="{Binding ContinueCommand}" IsDefault="True" c:InitialFocus.Rank="1" />
      </StackPanel>
    </Border>
  </Grid>
</views:PageView>
