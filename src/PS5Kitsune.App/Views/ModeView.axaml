<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                x:Class="PS5Kitsune.App.Views.ModeView"
                x:DataType="vm:ModeViewModel">
  <Grid RowDefinitions="*,Auto,Auto">
    <StackPanel Grid.Row="0" Spacing="16">
      <TextBlock Text="How should AnyPS5 be installed?" Classes="h1" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16" c:ArrowSelection.IsEnabled="True">
        <RadioButton GroupName="Mode" Theme="{StaticResource OptionCard}" IsChecked="{Binding IsReleaseSelected}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding ReleaseTitle}" Classes="h2" />
            <TextBlock Text="{Binding ReleaseInstalledText}" FontWeight="SemiBold" IsVisible="{Binding ReleaseInstalledText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="In use" FontWeight="SemiBold" IsVisible="{Binding IsReleaseInUse}" />
            <TextBlock Text="{Binding PublishedText}" />
            <TextBlock Text="{Binding ProfileStatusText}" />
            <TextBlock Text="A few minutes, no compilation." />
          </StackPanel>
        </RadioButton>
        <RadioButton Grid.Column="1" GroupName="Mode" Theme="{StaticResource OptionCard}" IsChecked="{Binding IsBuildSelected}"
                     IsEnabled="{Binding CanBuild}">
          <StackPanel Spacing="6">
            <TextBlock Text="Build from source" Classes="h2" />
            <TextBlock Text="{Binding BuildInstalledText}" FontWeight="SemiBold" IsVisible="{Binding BuildInstalledText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="In use" FontWeight="SemiBold" IsVisible="{Binding IsBuildInUse}" />
            <StackPanel Spacing="6" IsVisible="{Binding CanBuild}">
              <TextBlock Text="{Binding BuildCommitText}" />
              <TextBlock Text="{Binding ProfileStatusText}" />
              <TextBlock Text="{Binding BuildDurationText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding BuildDiskText}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding BuildUnavailableText}" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding !CanBuild}" />
          </StackPanel>
        </RadioButton>
      </Grid>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding ErrorText}" Classes="error" AutomationProperties.LiveSetting="Assertive" Margin="0,16,0,0"
               IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <Border Grid.Row="2" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Back" Command="{Binding BackCommand}" IsCancel="True" />
        <Button Content="{Binding ContinueText}" Classes="accent" Command="{Binding ContinueCommand}" IsDefault="True" c:InitialFocus.Rank="1" />
      </StackPanel>
    </Border>
  </Grid>
</views:PageView>
