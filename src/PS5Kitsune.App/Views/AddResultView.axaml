<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                xmlns:sys="using:System"
                x:Class="PS5Kitsune.App.Views.AddResultView"
                x:DataType="vm:AddResultViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <c:StatusChip Kind="{Binding VerdictKind}" Text="{Binding VerdictLabel}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding VerdictText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="{Binding CountsText}" />
        <TextBlock Text="{Binding BeforeText}" Classes="caption" IsVisible="{Binding BeforeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding MissingLibrariesText}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                   IsVisible="{Binding MissingLibrariesText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Expander Header="{Binding UnresolvedHeader}" IsVisible="{Binding HasUnresolved}" HorizontalAlignment="Stretch">
          <ScrollViewer MaxHeight="260">
            <ItemsControl ItemsSource="{Binding UnresolvedLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <SelectableTextBlock Text="{Binding}" Classes="mono" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Expander>
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Text="{Binding}" Classes="warning" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding OpenError}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                   IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="footer">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="Open the game folder" Command="{Binding OpenFolderCommand}" />
          <Button Content="Add another game" Command="{Binding AddAnotherCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button Content="Go to library" Classes="accent" Command="{Binding BackToLibraryCommand}" IsDefault="True" c:InitialFocus.Rank="1" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</views:PageView>
