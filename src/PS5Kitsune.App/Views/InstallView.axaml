<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                xmlns:sys="using:System"
                x:Class="PS5Kitsune.App.Views.InstallView"
                x:DataType="vm:InstallViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="12">
      <TextBlock Text="Installing AnyPS5" Classes="h1" />
      <Border Classes="card">
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstallStepViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="caption" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <StackPanel IsVisible="{Binding ShowsProgress}" Spacing="4">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding ProgressIndeterminate}"
                     AutomationProperties.Name="Install progress" />
        <TextBlock Text="{Binding ProgressText}" Classes="caption" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <TextBlock Text="{Binding Failure}" IsVisible="{Binding HasFailed}" Classes="error" FontWeight="SemiBold"
                 AutomationProperties.LiveSetting="Assertive" />
      <Expander Header="Show details" HorizontalAlignment="Stretch"
                IsVisible="{Binding FailureDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ScrollViewer MaxHeight="220">
          <SelectableTextBlock Text="{Binding FailureDetails}" Classes="mono" />
        </ScrollViewer>
      </Expander>
      <TextBlock Text="{Binding OpenError}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                 IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="log" Margin="0,16,0,0">
      <ScrollViewer x:Name="LogScroller">
        <ItemsControl ItemsSource="{Binding Log}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Text="{Binding}" Classes="mono" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Classes="footer">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Content="Open log" Command="{Binding OpenLogCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" IsCancel="True" c:InitialFocus.Rank="2" />
          <Button Content="Back to home" Command="{Binding BackHomeCommand}" IsVisible="{Binding HasFailed}" />
          <Button Content="Retry" Classes="accent" Command="{Binding RetryCommand}" IsVisible="{Binding HasFailed}" IsDefault="True" c:InitialFocus.Rank="1" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</views:PageView>
