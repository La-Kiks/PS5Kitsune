<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PS5Kitsune.App.ViewModels"
        xmlns:views="using:PS5Kitsune.App.Views"
        xmlns:c="using:PS5Kitsune.App.Controls"
        x:Class="PS5Kitsune.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PS5Kitsune"
        Icon="/Assets/kitsune.ico"
        Background="{DynamicResource Surface.Page}"
        FontSize="13"
        Width="860" Height="680" MinWidth="720" MinHeight="480">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:SystemCheckViewModel">
      <views:SystemCheckView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModeViewModel">
      <views:ModeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ToolsViewModel">
      <views:ToolsView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstallViewModel">
      <views:InstallView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChooseGameViewModel">
      <views:ChooseGameView />
    </DataTemplate>
    <DataTemplate DataType="vm:GameSummaryViewModel">
      <views:GameSummaryView />
    </DataTemplate>
    <DataTemplate DataType="vm:AddGameViewModel">
      <views:AddGameView />
    </DataTemplate>
    <DataTemplate DataType="vm:ReconvertViewModel">
      <views:ReconvertView />
    </DataTemplate>
    <DataTemplate DataType="vm:AddResultViewModel">
      <views:AddResultView />
    </DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="vm:GameViewModel">
      <views:GameView />
    </DataTemplate>
    <DataTemplate DataType="vm:GameSettingsViewModel">
      <views:GameSettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:DoneViewModel">
      <views:DoneView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="168,*">
    <Border Background="{DynamicResource Surface.Sidebar}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,16">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,0,20">
          <Image Source="/Assets/kitsune.ico" Width="24" Height="24" AutomationProperties.Name="PS5Kitsune" />
          <TextBlock Text="PS5Kitsune" Classes="h2" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="4">
          <Button Classes="nav" Classes.current="{Binding IsHomeCurrent}" Content="Home" Command="{Binding GoHomeCommand}"
                  ToolTip.Tip="{Binding NavTip}" AutomationProperties.ItemStatus="{Binding HomeItemStatus}" />
          <Button Classes="nav" Classes.current="{Binding IsLibraryCurrent}" Content="Library" Command="{Binding GoLibraryCommand}"
                  ToolTip.Tip="{Binding NavTip}" AutomationProperties.ItemStatus="{Binding LibraryItemStatus}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="16">
          <StackPanel Spacing="4" Margin="4,0" IsVisible="{Binding UpdateNotice.HasUpdate}">
            <TextBlock Text="Update available" Classes="caption" />
            <TextBlock Text="{Binding UpdateNotice.Text}" TextWrapping="Wrap" />
            <Button Classes="accent" Content="Download" Command="{Binding UpdateNotice.OpenCommand}" HorizontalAlignment="Left"
                    AutomationProperties.Name="{Binding UpdateNotice.ButtonName}" ToolTip.Tip="Opens the release page in your browser" />
            <TextBlock Text="{Binding UpdateNotice.OpenError}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                       IsVisible="{Binding UpdateNotice.OpenError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                      c:ArrowSelection.IsEnabled="True">
            <RadioButton GroupName="Theme" Theme="{StaticResource {x:Type ToggleButton}}" Content="◐" Padding="10,4"
                         IsChecked="{Binding IsSystemTheme}" ToolTip.Tip="System theme" AutomationProperties.Name="System theme" />
            <RadioButton GroupName="Theme" Theme="{StaticResource {x:Type ToggleButton}}" Content="☀" Padding="10,4"
                         IsChecked="{Binding IsLightTheme}" ToolTip.Tip="Light theme" AutomationProperties.Name="Light theme" />
            <RadioButton GroupName="Theme" Theme="{StaticResource {x:Type ToggleButton}}" Content="☾" Padding="10,4"
                         IsChecked="{Binding IsDarkTheme}" ToolTip.Tip="Dark theme" AutomationProperties.Name="Dark theme" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Column="1" Margin="24" Content="{Binding Navigator.CurrentPage}" />
  </Grid>
</Window>
