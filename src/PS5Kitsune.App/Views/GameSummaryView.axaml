<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                x:Class="PS5Kitsune.App.Views.GameSummaryView"
                x:DataType="vm:GameSummaryViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Back" Command="{Binding BackCommand}" IsCancel="True" />
        <Button Content="Add the game" Classes="accent" Command="{Binding AddCommand}" IsDefault="True" c:InitialFocus.Rank="1" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Panel Width="64" Height="64">
            <Border Background="{DynamicResource Surface.Raised}" CornerRadius="8" />
            <Image Width="64" Height="64" Source="{Binding IconPath, Converter={x:Static views:PathToBitmapConverter.Instance}}" />
          </Panel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Classes="h1" />
            <TextBlock Text="{Binding TitleId}" Classes="caption" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding SizeText}" />
        <TextBlock Text="{Binding ModulesText}" />
        <TextBlock Text="{Binding BinariesText}" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding BlockingIssues}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Warnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="warning" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card" IsVisible="{Binding AlreadyAddedText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding AlreadyAddedText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ConversionText}" Classes="caption"
                       IsVisible="{Binding ConversionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="Open its folder" Command="{Binding OpenFolderCommand}" />
              <Button Content="Reconvert" Command="{Binding ReconvertCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding ResumeText}" Classes="caption"
                   IsVisible="{Binding ResumeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding OpenError}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                   IsVisible="{Binding OpenError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <CheckBox Content="Convert for an Intel CPU" IsChecked="{Binding ToIntel}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</views:PageView>
