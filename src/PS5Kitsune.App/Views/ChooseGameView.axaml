<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                x:Class="PS5Kitsune.App.Views.ChooseGameView"
                x:DataType="vm:ChooseGameViewModel"
                DragDrop.AllowDrop="True">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Spacing="16">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" />
      <Border Name="DropZone" Classes="dropzone">
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Drop the folder or .zip here" Classes="h2" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" />
          <WrapPanel ItemSpacing="12" LineSpacing="12" HorizontalAlignment="Center">
            <Button Content="Choose a folder…" Command="{Binding ChooseFolderCommand}" c:InitialFocus.Rank="1" />
            <Button Content="Choose a .zip…" Command="{Binding ChooseZipCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsPreparing}">
        <TextBlock Text="Reading the game…" VerticalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="Reading the game" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <Border Grid.Row="1" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
        <Button Content="Back" Command="{Binding BackCommand}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</views:PageView>
