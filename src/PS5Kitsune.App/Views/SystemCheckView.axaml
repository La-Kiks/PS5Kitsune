<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                xmlns:conv="using:PS5Kitsune.App.Converters"
                xmlns:sys="using:System"
                x:Class="PS5Kitsune.App.Views.SystemCheckView"
                x:DataType="vm:SystemCheckViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Back" Command="{Binding BackCommand}" IsCancel="True" />
        <Button Content="Continue" Classes="accent" Command="{Binding ContinueCommand}" IsDefault="True" c:InitialFocus.Rank="1" />
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="System check" Classes="h1" />

    <Border DockPanel.Dock="Top" Classes="card" Margin="0,16,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <c:StatusChip Kind="{Binding BannerStatus, Converter={x:Static conv:CheckStatusKindConverter.Instance}}"
                      Text="{Binding BannerLabel}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsChecking}" Width="80" VerticalAlignment="Center"
                       AutomationProperties.Name="Checking" />
          <TextBlock Text="{Binding Verdict}" Classes="h2" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="2" Content="Check again" Command="{Binding CheckCommand}" VerticalAlignment="Center" c:InitialFocus.Rank="2" />
      </Grid>
    </Border>

    <Expander DockPanel.Dock="Bottom" Header="Detected GPUs" Margin="0,16,0,0" HorizontalAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding Gpus}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sys:String">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <ScrollViewer Margin="0,16,0,0">
      <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding !IsChecking}">
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CheckRowViewModel">
              <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                <c:StatusChip Kind="{Binding Status, Converter={x:Static conv:CheckStatusKindConverter.Instance}}" Text="{Binding StatusText}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Action}" IsVisible="{Binding HasAction}" Classes="caption" />
                  <TextBlock Text="{Binding FixError}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                             IsVisible="{Binding FixError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Open performance settings" VerticalAlignment="Top"
                        Command="{Binding OpenFixCommand}" IsVisible="{Binding HasFix}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </ScrollViewer>
  </DockPanel>
</views:PageView>
