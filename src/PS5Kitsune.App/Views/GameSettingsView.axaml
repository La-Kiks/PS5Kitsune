<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PS5Kitsune.App.ViewModels"
                xmlns:library="using:PS5Kitsune.Core.Library"
                xmlns:views="using:PS5Kitsune.App.Views"
                xmlns:c="using:PS5Kitsune.App.Controls"
                x:Class="PS5Kitsune.App.Views.GameSettingsView"
                x:DataType="vm:GameSettingsViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <Border Classes="card" IsVisible="{Binding IsRunning}">
        <TextBlock Text="{Binding RunningNotice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </Border>
      <TextBlock Text="{Binding Message}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                 IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                 IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
      <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
        <StackPanel Spacing="4">
          <TextBlock x:Name="GpuLabel" Text="GPU" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" IsEnabled="{Binding CanChooseGpu}" MinWidth="320"
                    AutomationProperties.LabeledBy="{Binding #GpuLabel}" c:InitialFocus.Rank="1">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GpuChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding GpuStatus}" IsVisible="{Binding GpuStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <CheckBox Content="CPU rendering (Lavapipe)" IsChecked="{Binding Lavapipe}" IsEnabled="{Binding CanEdit}" c:InitialFocus.Rank="2" />
          <TextBlock Text="{Binding LavapipeHelp}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock x:Name="LanguageLabel" Text="Game language" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" IsEnabled="{Binding CanEdit}" MinWidth="320"
                    AutomationProperties.LabeledBy="{Binding #LanguageLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="library:GameLanguage">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock x:Name="VsyncLabel" Text="Vertical sync" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding PresentModes}" SelectedItem="{Binding SelectedPresentMode}" IsEnabled="{Binding CanEdit}" MinWidth="320"
                    AutomationProperties.LabeledBy="{Binding #VsyncLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding ShowDisableDozen}">
          <CheckBox Content="Disable Dozen" IsChecked="{Binding DisableDozen}" IsEnabled="{Binding CanChooseGpu}" />
          <TextBlock Text="{Binding DozenHelp}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <CheckBox Content="Performance overlay" IsChecked="{Binding Overlay}" IsEnabled="{Binding CanEdit}" />
          <TextBlock Text="{Binding OverlayHelp}" Classes="caption" />
          <TextBlock x:Name="OverlayPositionLabel" Text="Overlay position" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding OverlayPositions}" SelectedItem="{Binding SelectedOverlayPosition}" IsEnabled="{Binding CanChooseOverlayPosition}" MinWidth="200"
                    AutomationProperties.LabeledBy="{Binding #OverlayPositionLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <Expander Header="Advanced">
          <StackPanel Spacing="4">
            <TextBlock x:Name="PlayGoLabel" Text="PlayGo unlisted chunks" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding PlayGoChoices}" SelectedItem="{Binding SelectedPlayGo}" IsEnabled="{Binding CanEdit}" MinWidth="320"
                      AutomationProperties.LabeledBy="{Binding #PlayGoLabel}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingChoice">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding PlayGoHelp}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="footer">
      <DockPanel>
        <Button Content="Reset to defaults" Command="{Binding ResetCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button Content="Back" Command="{Binding BackCommand}" IsCancel="True" c:InitialFocus.Rank="3" />
          <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</views:PageView>
